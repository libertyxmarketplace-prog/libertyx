# ── Required ─────────────────────────────────────────────────────────────
# Your bot token (Developer Portal → Bot. Regenerate if ever leaked).
DISCORD_TOKEN=replace_with_your_discord_bot_token

# Discord application client ID (Developer Portal → Application → General Information).
CLIENT_ID=your_discord_application_client_id

# ID of the server where /session is registered and where the ping buttons work.
GUILD_ID=your_server_id

# ── Optional ─────────────────────────────────────────────────────────────
# If set, /session posts the public card to THIS channel instead of where you typed it.
# Leave empty to post right in the channel where /session is used.
SESSION_CHANNEL_ID=

# ER:LC (PRC) API key. Leave EMPTY if you don't use the API
# (players/queue/staff will show "Unavailable", card still posts fine).
ERLC_API_KEY=

# Optional overrides — leave EMPTY to keep the hardcoded SERVER block
# (Alabama / Rose / ALABAM / banner) in src/index.js.
ERLC_SERVER_CODE=
SESSION_BANNER_URL=