# ── Required ─────────────────────────────────────────────────────────────
# Your bot token (Developer Portal → Bot. Regenerate if ever leaked).
DISCORD_TOKEN=replace_with_your_discord_bot_token

# Discord application client ID (Developer Portal → Application → General Information).
CLIENT_ID=your_discord_application_client_id

# ID of the server where /session is registered and where the ping buttons work.
GUILD_ID=your_server_id

# ── Optional ─────────────────────────────────────────────────────────────
# If set, /session posts the public card to THIS channel instead of where you typed it.
# Leave empty to post right in the channel where /session is used.
SESSION_CHANNEL_ID=

# ER:LC (PRC) API key. Leave EMPTY if you don't use the API
# (players/queue/staff will show "Unavailable", card still posts fine).
ERLC_API_KEY=

# Optional overrides — leave EMPTY to keep the hardcoded SERVER block
# (Alabama / Rose / ALABAM / banner) in src/index.js.
ERLC_SERVER_CODE=
SESSION_BANNER_URL=

# ── AI Command Engine ─────────────────────────────────────────────────────────
# Powers the `-ai <plain english request>` prefix command, for example:
#   -ai start a session vote with 5 users
#   -ai close the general ticket
#   -ai ban @user for 7 days for spamming
#
# Three independent providers are tried in order. Whichever answers first wins,
# so you only need ONE working key. Each provider gets its own circuit breaker,
# so a rate-limited or empty provider is skipped for free instead of retried.
# With no keys at all the bot still works via its built-in offline parser.

# 1) FreeTheAI — free. Needs a daily check-in at https://freetheai.org/checkin
#    AND has a daily request cap that resets at 00:00 UTC.
#    Models: GET https://api.freetheai.org/v1/models
AI_API_KEY=
AI_API_URL=https://api.freetheai.org

# 2) OpenRouter — paid/credit based, very reliable. Get a key at
#    https://openrouter.ai/keys. The defaults below are tried in order.
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1

# 3) HuggingFace — free inference router. Get a token at
#    https://huggingface.co/settings/tokens (enable "Inference Providers").
#    Models: GET https://router.huggingface.co/v1/models
HUGGINGFACE_API_KEY=
HUGGINGFACE_API_URL=https://router.huggingface.co/v1

# Optional: pin model ids (comma separated) instead of using the built-in lists.
AI_MODEL=
OPENROUTER_MODEL=
HUGGINGFACE_MODEL=